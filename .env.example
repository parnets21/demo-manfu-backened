# ── Manufacturing ERP Backend — Environment Variables Template ──────────────────
# Copy this file to .env and fill in the values
# Do NOT commit .env to git

# MongoDB Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>/<dbname>?appName=<app>
MONGO_URI="mongodb+srv://parnetstech21_db_user:<PASSWORD>@cluster0.gh4yok0.mongodb.net/manufacturingErp?appName=Cluster0"

# JWT Secret — generate a random string for production
JWT_SECRET=your_jwt_secret_here

# Server Configuration
NODE_ENV=development
PORT=5001

# SMTP (email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Manufacturing ERP

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
